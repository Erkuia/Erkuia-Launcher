import { Theme, Typo } from "theme.slint";

component WindowButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger;
    callback clicked();

    width: Theme.icon-button-size;
    height: Theme.icon-button-size;
    border-radius: Theme.radius-icon-button;
    background: root.danger
        ? (touch-area.pressed ? Theme.danger-pressed : (touch-area.has-hover ? Theme.danger : transparent))
        : (touch-area.pressed ? Theme.control : (touch-area.has-hover ? Theme.badge : transparent));

    Text {
        text: root.glyph;
        color: (root.danger && touch-area.has-hover) ? Theme.on-accent : Theme.secondary;
        font-size: Typo.icon-glyph;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component TitleBar inherits Rectangle {
    in property <string> title;
    callback drag-started(float, float);
    callback drag-moved(float, float);
    callback drag-ended();
    callback minimize-clicked();
    callback close-clicked();

    height: Theme.title-bar-height;
    background: Theme.surface;

    TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width - Theme.title-bar-pad-right - 2 * Theme.icon-button-size - 4px;
        height: parent.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag-started(self.pressed-x / 1px, self.pressed-y / 1px);
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.drag-ended();
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-moved(self.mouse-x / 1px, self.mouse-y / 1px);
            }
        }
    }

    HorizontalLayout {
        spacing: 4px;
        padding-left: Theme.title-bar-pad-left;
        padding-right: Theme.title-bar-pad-right;
        padding-top: (Theme.title-bar-height - Theme.icon-button-size) / 2;
        padding-bottom: (Theme.title-bar-height - Theme.icon-button-size) / 2;

        Text {
            text: root.title;
            color: Theme.label;
            font-size: Typo.title-bar;
            font-weight: Typo.medium;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }

        Rectangle {
            background: transparent;
            horizontal-stretch: 1;
        }

        WindowButton {
            glyph: "–";
            clicked => {
                root.minimize-clicked();
            }
        }

        WindowButton {
            glyph: "×";
            danger: true;
            clicked => {
                root.close-clicked();
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}
