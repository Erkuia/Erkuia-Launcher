import { ScrollView } from "std-widgets.slint";
import { Theme, Typo } from "theme.slint";
import { SecondaryButton, ReadOnlyField, Divider } from "controls.slint";
import { ValueSlider } from "slider.slint";

component SectionLabel inherits VerticalLayout {
    in property <string> text;

    padding-bottom: 1px;

    Text {
        text: root.text;
        color: Theme.secondary;
        font-size: Typo.section-caps;
        font-weight: Typo.bold;
        letter-spacing: Typo.section-caps-spacing;
    }
}

component CloseButton inherits Rectangle {
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: Theme.radius-modal-close;
    background: touch.pressed
        ? Theme.control
        : (touch.has-hover ? Theme.field-background : transparent);

    Text {
        text: "×";
        color: Theme.secondary;
        font-size: Typo.modal-close;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component SettingsPanel inherits VerticalLayout {
    in property <string> program-directory;
    in-out property <int> target-fps;
    callback close();
    callback open-directory();
    callback fps-changed(int);

    spacing: 0px;

    HorizontalLayout {
        vertical-stretch: 0;

        VerticalLayout {
            alignment: center;
            padding-bottom: 2px;

            Text {
                text: "설정";
                color: Theme.heading;
                font-size: Typo.modal-title;
                font-weight: Typo.bold;
            }
        }

        Rectangle {
            background: transparent;
            horizontal-stretch: 1;
        }

        CloseButton {
            clicked => {
                root.close();
            }
        }
    }

    VerticalLayout {
        vertical-stretch: 1;
        padding-top: 4px;

        ScrollView {
            VerticalLayout {
                padding-right: 12px;
                padding-top: 16px;
                spacing: 4px;

                SectionLabel {
                    text: "렌더링";
                }

                VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 2px;

                    Text {
                        text: "목표 FPS";
                        color: Theme.strong;
                        font-size: Typo.body;
                    }
                }

                ValueSlider {
                    value <=> root.target-fps;
                    changed(fps) => {
                        root.fps-changed(fps);
                    }
                }

                VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 18px;

                    Text {
                        text: "목표 FPS에 맞춰 셰이더 품질과 LOD가 자동으로 조정돼요.";
                        color: Theme.tick;
                        font-size: Typo.caption;
                    }
                }

                Divider { }

                @children
            }
        }
    }

    VerticalLayout {
        vertical-stretch: 0;
        height: 31px;
        padding-top: 16px;
        padding-bottom: 14px;

        Divider { }
    }

    VerticalLayout {
        vertical-stretch: 0;
        padding-bottom: 1px;

        Text {
            text: "프로그램 디렉토리";
            color: Theme.muted;
            font-size: Typo.footer;
        }
    }

    VerticalLayout {
        vertical-stretch: 0;
        padding-top: 8px;

        HorizontalLayout {
            spacing: 8px;

            ReadOnlyField {
                text: root.program-directory;
                horizontal-stretch: 1;
            }

            SecondaryButton {
                text: "열기";
                compact: true;
                clicked => {
                    root.open-directory();
                }
            }
        }
    }
}
