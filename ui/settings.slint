import { ScrollView } from "std-widgets.slint";
import { Theme, Typo } from "theme.slint";
import { SecondaryButton, ReadOnlyField, Divider } from "controls.slint";
import { ModRow, AddModButton, ModEntry } from "mods.slint";

component SectionLabel inherits VerticalLayout {
    in property <string> text;

    padding-bottom: 1px;

    Text {
        text: root.text;
        color: Theme.secondary;
        font-size: Typo.section-caps;
        font-weight: Typo.bold;
        letter-spacing: Typo.section-caps-spacing;
    }
}

component CloseButton inherits Rectangle {
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: Theme.radius-modal-close;
    background: touch.pressed
        ? Theme.control
        : (touch.has-hover ? Theme.field-background : transparent);

    Text {
        text: "×";
        color: Theme.secondary;
        font-size: Typo.modal-close;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component SettingsPanel inherits VerticalLayout {
    in property <string> program-directory;
    in property <[ModEntry]> local-mods;
    callback close();
    callback open-directory();
    callback add-mod();
    callback toggle-mod(string, bool);
    callback remove-mod(string);

    spacing: 0px;

    HorizontalLayout {
        vertical-stretch: 0;

        VerticalLayout {
            alignment: center;
            padding-bottom: 2px;

            Text {
                text: "설정";
                color: Theme.heading;
                font-size: Typo.modal-title;
                font-weight: Typo.bold;
            }
        }

        Rectangle {
            background: transparent;
            horizontal-stretch: 1;
        }

        CloseButton {
            clicked => {
                root.close();
            }
        }
    }

    VerticalLayout {
        // Not stretchy any more: the scroll area is as tall as the list, so
        // there is no slack for this to swallow and hand back as a gap.
        vertical-stretch: 0;
        padding-top: 4px;

        ScrollView {
            // Reading the list's preferred height rather than filling. The cap
            // is what turns it back into a scroller once enough mods are
            // installed to need one.
            height: Math.min(Theme.settings-list-max-height, list.preferred-height);

            list := VerticalLayout {
                padding-right: 12px;
                padding-top: 16px;
                spacing: 4px;

                SectionLabel {
                    text: "모드";
                    vertical-stretch: 0;
                }

                VerticalLayout {
                    padding-top: 8px;
                    spacing: 14px;
                    vertical-stretch: 0;

                    for entry in root.local-mods: ModRow {
                        name: entry.name;
                        description: entry.description;
                        removable: true;
                        enabled: entry.enabled;
                        toggled(on) => {
                            root.toggle-mod(entry.id, on);
                        }
                        removed => {
                            root.remove-mod(entry.id);
                        }
                    }

                    AddModButton {
                        clicked => {
                            root.add-mod();
                        }
                    }
                }
            }
        }
    }

    VerticalLayout {
        vertical-stretch: 0;
        height: 31px;
        padding-top: 16px;
        padding-bottom: 14px;

        Divider { }
    }

    VerticalLayout {
        vertical-stretch: 0;
        padding-bottom: 1px;

        Text {
            text: "프로그램 위치";
            color: Theme.muted;
            font-size: Typo.footer;
        }
    }

    VerticalLayout {
        vertical-stretch: 0;
        padding-top: 8px;

        HorizontalLayout {
            spacing: 8px;

            ReadOnlyField {
                text: root.program-directory;
                horizontal-stretch: 1;
            }

            SecondaryButton {
                text: "열기";
                compact: true;
                clicked => {
                    root.open-directory();
                }
            }
        }
    }
}
