import { Theme, Typo } from "theme.slint";
import { TitleBar } from "title_bar.slint";
import { PrimaryButton, ProgressBar, SecondaryButton, AccentButton, TextButton, Toggle, Badge, Divider, ReadOnlyField } from "controls.slint";
import { ErrorModal } from "error.slint";
import { ValueSlider } from "slider.slint";
import { ModalOverlay, Popover } from "overlays.slint";
import { ProfileChip, ProfileMenu, Account } from "profile.slint";
import { SettingsPanel } from "settings.slint";
import { ModEntry } from "mods.slint";

export component LauncherWindow inherits Window {
    in-out property <string> product-name: "Rendog Launcher";
    in-out property <string> launcher-version: "v0.1.0";
    in-out property <string> server-address: "rendog.kr";
    in-out property <string> minecraft-version: "1.20.4";
    in-out property <string> program-directory: "";
    in-out property <string> data-directory: "";

    in-out property <bool> signed-in;
    in-out property <string> account-name;
    in-out property <string> account-initial;
    in-out property <image> account-avatar;
    in-out property <[Account]> other-accounts;

    in-out property <bool> profile-open;
    in-out property <bool> settings-open;

    in-out property <int> target-fps: 105;
    in-out property <bool> adaptive-rendering: true;
    in-out property <[ModEntry]> local-mods;

    in-out property <bool> busy;
    in-out property <float> progress;
    in-out property <bool> progress-indeterminate;
    in-out property <string> status-hint: "시작하려면 먼저 로그인해 주세요";

    in-out property <bool> error-open;
    in-out property <string> error-code;
    in-out property <string> error-message;
    in-out property <bool> error-retryable: true;

    callback title-drag-started(float, float);
    callback title-drag-moved(float, float);
    callback title-drag-ended();
    callback minimize-clicked();
    callback close-clicked();
    callback start-clicked();
    callback login-clicked();
    callback add-account-clicked();
    callback logout-clicked();
    callback switch-account(string);
    callback open-directory-clicked();
    callback fps-changed(int);
    callback adaptive-changed(bool);
    callback add-mod-clicked();
    callback toggle-mod(string, bool);
    callback remove-mod(string);
    callback error-retry();

    title: root.product-name;
    no-frame: true;
    width: Theme.window-width;
    height: Theme.window-height;
    background: transparent;
    default-font-family: Typo.family;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.surface;
        border-radius: Theme.radius-window;
        border-width: 1px;
        border-color: Theme.frame-border;
        clip: true;

        FocusScope {
            width: 100%;
            height: 100%;

            init => {
                self.focus();
            }

            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    if (root.error-open) {
                        root.error-open = false;
                        return accept;
                    }
                    if (root.settings-open) {
                        root.settings-open = false;
                        return accept;
                    }
                    if (root.profile-open) {
                        root.profile-open = false;
                        return accept;
                    }
                }
                return reject;
            }

            VerticalLayout {
                spacing: 0px;

                TitleBar {
                    title: root.product-name;
                    drag-started(x, y) => {
                        root.title-drag-started(x, y);
                    }
                    drag-moved(x, y) => {
                        root.title-drag-moved(x, y);
                    }
                    drag-ended => {
                        root.title-drag-ended();
                    }
                    minimize-clicked => {
                        root.minimize-clicked();
                    }
                    close-clicked => {
                        root.close-clicked();
                    }
                }

                Rectangle {
                    background: transparent;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding-left: Theme.content-pad-x;
                        padding-right: Theme.content-pad-x;
                        padding-top: Theme.content-pad-top;
                        padding-bottom: Theme.content-pad-bottom;
                        spacing: 0px;

                        HorizontalLayout {
                            vertical-stretch: 0;

                            ProfileChip {
                                signed-in: root.signed-in;
                                name: root.account-name;
                                initial: root.account-initial;
                                avatar: root.account-avatar;
                                clicked => {
                                    root.profile-open = !root.profile-open;
                                }
                            }

                            Rectangle {
                                background: transparent;
                                horizontal-stretch: 1;
                            }

                            SecondaryButton {
                                text: "Settings";
                                clicked => {
                                    root.settings-open = true;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            vertical-stretch: 1;

                            HorizontalLayout {
                                alignment: center;

                                Rectangle {
                                    width: Theme.logo-size;
                                    height: Theme.logo-size;
                                    background: transparent;

                                    Image {
                                        width: Theme.logo-glyph;
                                        height: Theme.logo-glyph;
                                        source: @image-url("../assets/rendog-logo-256.png");
                                        image-fit: contain;
                                    }
                                }
                            }

                            VerticalLayout {
                                padding-top: 22px;

                                Text {
                                    text: "RENDOG LAUNCHER";
                                    color: Theme.heading;
                                    font-size: Typo.hero-title;
                                    font-weight: Typo.bold;
                                    letter-spacing: Typo.hero-title-spacing;
                                    horizontal-alignment: center;
                                }
                            }

                            VerticalLayout {
                                padding-top: 8px;

                                Text {
                                    text: root.server-address + " · Minecraft " + root.minecraft-version;
                                    color: Theme.muted;
                                    font-size: Typo.hero-subtitle;
                                    letter-spacing: Typo.hero-subtitle-spacing;
                                    horizontal-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                padding-top: 36px;

                                if !root.busy: PrimaryButton {
                                    text: "시작";
                                    enabled: root.signed-in;
                                    clicked => {
                                        root.start-clicked();
                                    }
                                }

                                if root.busy: Rectangle {
                                    width: Theme.progress-width;
                                    height: 49px;
                                    background: transparent;

                                    ProgressBar {
                                        progress: root.progress;
                                        indeterminate: root.progress-indeterminate;
                                    }
                                }
                            }

                            VerticalLayout {
                                padding-top: 14px;
                                padding-bottom: 2px;

                                Text {
                                    text: root.status-hint;
                                    visible: root.status-hint != "";
                                    color: Theme.disabled-text;
                                    font-size: Typo.small;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: root.launcher-version;
                            color: Theme.faint;
                            font-size: Typo.footer;
                            vertical-stretch: 0;
                        }
                    }

                    Popover {
                        width: 100%;
                        height: 100%;
                        open: root.profile-open;
                        anchor-x: Theme.content-pad-x;
                        anchor-y: Theme.content-pad-top + Theme.popover-offset-y;
                        close => {
                            root.profile-open = false;
                        }

                        ProfileMenu {
                            signed-in: root.signed-in;
                            account-name: root.account-name;
                            account-initial: root.account-initial;
                            account-avatar: root.account-avatar;
                            other-accounts: root.other-accounts;
                            login => {
                                root.profile-open = false;
                                root.login-clicked();
                            }
                            add-account => {
                                root.profile-open = false;
                                root.add-account-clicked();
                            }
                            logout => {
                                root.profile-open = false;
                                root.logout-clicked();
                            }
                            switch-account(id) => {
                                root.profile-open = false;
                                root.switch-account(id);
                            }
                        }
                    }

                    ModalOverlay {
                        width: 100%;
                        height: 100%;
                        open: root.settings-open;
                        close => {
                            root.settings-open = false;
                        }

                        SettingsPanel {
                            program-directory: root.program-directory;
                            target-fps <=> root.target-fps;
                            adaptive-rendering <=> root.adaptive-rendering;
                            local-mods: root.local-mods;
                            fps-changed(fps) => {
                                root.fps-changed(fps);
                            }
                            adaptive-changed(on) => {
                                root.adaptive-changed(on);
                            }
                            add-mod => {
                                root.add-mod-clicked();
                            }
                            toggle-mod(id, on) => {
                                root.toggle-mod(id, on);
                            }
                            remove-mod(id) => {
                                root.remove-mod(id);
                            }
                            close => {
                                root.settings-open = false;
                            }
                            open-directory => {
                                root.open-directory-clicked();
                            }
                        }
                    }

                    ErrorModal {
                        width: 100%;
                        height: 100%;
                        open: root.error-open;
                        code: root.error-code;
                        message: root.error-message;
                        retryable: root.error-retryable;
                        close => {
                            root.error-open = false;
                        }
                        retry => {
                            root.error-open = false;
                            root.error-retry();
                        }
                    }
                }
            }
        }
    }
}
