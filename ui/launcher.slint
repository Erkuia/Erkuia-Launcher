import { Theme, Typo } from "theme.slint";

export component LauncherWindow inherits Window {
    in-out property <string> product-name: "Rendog Launcher";
    in-out property <string> launcher-version: "v0.1.0";
    in-out property <string> server-address: "rendog.kr";
    in-out property <string> minecraft-version: "1.20.4";
    in-out property <string> program-directory: "";
    in-out property <string> data-directory: "";

    title: root.product-name;
    width: Theme.window-width;
    height: Theme.window-height;
    background: Theme.surface;
    default-font-family: Typo.family;

    VerticalLayout {
        alignment: center;
        spacing: 10px;

        Text {
            text: "RENDOG LAUNCHER";
            color: Theme.heading;
            font-size: Typo.hero-title;
            font-weight: Typo.bold;
            letter-spacing: Typo.hero-title-spacing;
            horizontal-alignment: center;
        }

        Text {
            text: root.server-address + " · Minecraft " + root.minecraft-version;
            color: Theme.muted;
            font-size: Typo.hero-subtitle;
            letter-spacing: Typo.hero-subtitle-spacing;
            horizontal-alignment: center;
        }

        Text {
            text: root.launcher-version;
            color: Theme.faint;
            font-size: Typo.footer;
            horizontal-alignment: center;
        }

        Text {
            text: "프로그램 " + root.program-directory;
            color: Theme.faint;
            font-size: Typo.footer;
            horizontal-alignment: center;
        }

        Text {
            text: "데이터 " + root.data-directory;
            color: Theme.faint;
            font-size: Typo.footer;
            horizontal-alignment: center;
        }
    }
}
