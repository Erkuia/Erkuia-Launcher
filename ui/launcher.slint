import { Theme, Typo } from "theme.slint";
import { TitleBar } from "title_bar.slint";
import { PrimaryButton, SecondaryButton, AccentButton, TextButton, Toggle, Badge, Divider, ReadOnlyField } from "controls.slint";
import { ValueSlider } from "slider.slint";
import { ModalOverlay, Popover } from "overlays.slint";

export component LauncherWindow inherits Window {
    in-out property <string> product-name: "Rendog Launcher";
    in-out property <string> launcher-version: "v0.1.0";
    in-out property <string> server-address: "rendog.kr";
    in-out property <string> minecraft-version: "1.20.4";
    in-out property <string> program-directory: "";
    in-out property <string> data-directory: "";

    in-out property <bool> signed-in;
    in-out property <string> account-name;
    in-out property <string> account-initial;

    in-out property <bool> profile-open;
    in-out property <bool> settings-open;

    in-out property <int> target-fps: 105;
    in-out property <bool> adaptive-rendering: true;

    in-out property <bool> busy;
    in-out property <string> status-hint: "시작하려면 먼저 로그인해 주세요";

    callback title-drag-started(float, float);
    callback title-drag-moved(float, float);
    callback title-drag-ended();
    callback minimize-clicked();
    callback close-clicked();

    title: root.product-name;
    no-frame: true;
    width: Theme.window-width;
    height: Theme.window-height;
    background: transparent;
    default-font-family: Typo.family;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.surface;
        border-radius: Theme.radius-window;
        border-width: 1px;
        border-color: Theme.frame-border;
        clip: true;

        FocusScope {
            width: 100%;
            height: 100%;

            init => {
                self.focus();
            }

            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    if (root.settings-open) {
                        root.settings-open = false;
                        return accept;
                    }
                    if (root.profile-open) {
                        root.profile-open = false;
                        return accept;
                    }
                }
                return reject;
            }

            VerticalLayout {
                spacing: 0px;

                TitleBar {
                    title: root.product-name;
                    drag-started(x, y) => {
                        root.title-drag-started(x, y);
                    }
                    drag-moved(x, y) => {
                        root.title-drag-moved(x, y);
                    }
                    drag-ended => {
                        root.title-drag-ended();
                    }
                    minimize-clicked => {
                        root.minimize-clicked();
                    }
                    close-clicked => {
                        root.close-clicked();
                    }
                }

                Rectangle {
                    background: transparent;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding-left: Theme.content-pad-x;
                        padding-right: Theme.content-pad-x;
                        padding-top: Theme.content-pad-top;
                        padding-bottom: Theme.content-pad-bottom;
                        spacing: 0px;

                        HorizontalLayout {
                            vertical-stretch: 0;

                            Rectangle {
                                background: transparent;
                                horizontal-stretch: 1;
                            }

                            SecondaryButton {
                                text: "Settings";
                                clicked => {
                                    root.settings-open = true;
                                }
                            }
                        }

                        Rectangle {
                            background: transparent;
                            vertical-stretch: 1;
                        }

                        Text {
                            text: root.launcher-version;
                            color: Theme.faint;
                            font-size: Typo.footer;
                            vertical-stretch: 0;
                        }
                    }

                    Popover {
                        width: 100%;
                        height: 100%;
                        open: root.profile-open;
                        anchor-x: Theme.content-pad-x;
                        anchor-y: Theme.content-pad-top + Theme.popover-offset-y;
                        close => {
                            root.profile-open = false;
                        }
                    }

                    ModalOverlay {
                        width: 100%;
                        height: 100%;
                        open: root.settings-open;
                        close => {
                            root.settings-open = false;
                        }
                    }
                }
            }
        }
    }
}
