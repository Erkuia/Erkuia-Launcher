import { CheckBox, LineEdit } from "std-widgets.slint";

component StepRow inherits Rectangle {
    in property <string> label;
    in property <int> number;
    in property <bool> active;
    in property <bool> done;

    height: 24px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: active ? #0b73f6 : #ffffff;
            border-width: active ? 0px : 1px;
            border-color: #cfd8dc;

            Text {
                text: done ? "✓" : number;
                color: active ? #ffffff : #6b7280;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: label;
            color: active ? #111827 : #9ca3af;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    width: 92px;
    height: 34px;
    border-radius: 6px;
    background: touch-area.pressed ? #075bc7 : (touch-area.has-hover ? #0968df : #0b73f6);

    Text {
        text: root.text;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    width: 78px;
    height: 34px;
    border-radius: 6px;
    background: touch-area.pressed ? #edf2f7 : (touch-area.has-hover ? #f3f6f9 : transparent);
    border-width: 1px;
    border-color: #d5dbe3;

    Text {
        text: root.text;
        color: #111827;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    width: 50px;
    height: 34px;
    background: transparent;

    Text {
        text: root.text;
        color: touch-area.has-hover ? #111827 : #4b5563;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component WindowCloseButton inherits Rectangle {
    callback clicked();

    width: 42px;
    height: 34px;
    background: touch-area.pressed ? #dc2626 : (touch-area.has-hover ? #ef4444 : transparent);

    Text {
        text: "×";
        color: touch-area.has-hover ? #ffffff : #4b5563;
        font-size: 17px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component WindowMinimizeButton inherits Rectangle {
    callback clicked();

    width: 42px;
    height: 34px;
    background: touch-area.pressed ? #d1d5db : (touch-area.has-hover ? #e5e7eb : transparent);

    Text {
        text: "–";
        color: #4b5563;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TitleBar inherits Rectangle {
    in property <string> title;
    callback drag-started(float, float);
    callback drag-moved(float, float);
    callback close-clicked();
    callback minimize-clicked();

    height: 34px;
    background: #fbfbfc;
    border-width: 0px;

    HorizontalLayout {
        spacing: 0px;
        padding-left: 12px;

        Image {
            width: 16px;
            height: 16px;
            source: @image-url("../assets/rendog-logo-16.png");
        }

        Rectangle {
            width: 8px;
            background: transparent;
        }

        Text {
            text: root.title;
            color: #2f3744;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Rectangle {
            background: transparent;
        }

        WindowMinimizeButton {
            clicked => { root.minimize-clicked(); }
        }

        WindowCloseButton {
            clicked => { root.close-clicked(); }
        }
    }

    drag-area := TouchArea {
        width: parent.width - 84px;
        height: parent.height;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-started(self.pressed-x / 1px, self.pressed-y / 1px);
            }
        }
        moved => {
            if self.pressed {
                root.drag-moved(self.mouse-x / 1px, self.mouse-y / 1px);
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #e5e7eb;
    }
}

component WelcomePage inherits Rectangle {
    in property <string> product-name;
    callback continue-clicked();

    background: transparent;

    VerticalLayout {
        padding-left: 90px;
        padding-right: 90px;
        alignment: center;
        spacing: 18px;

        Image {
            width: 64px;
            height: 64px;
            source: @image-url("../assets/rendog-logo-72.png");
        }
        Text {
            text: "반가워요! " + product-name + "를\n설치해 볼게요";
            color: #111827;
            font-size: 25px;
            font-weight: 800;
        }
        Text {
            text: "전용 서버 클라이언트에 필요한 파일을 준비해요.";
            color: #6b7280;
            font-size: 12px;
        }
        PrimaryButton {
            text: "시작";
            clicked => { root.continue-clicked(); }
        }
    }
}

component PathPage inherits Rectangle {
    in-out property <string> install-path;
    in-out property <bool> run-after-install;
    in-out property <bool> create-desktop-shortcut;
    callback continue-clicked();
    callback browse-clicked();

    background: transparent;

    VerticalLayout {
        padding-left: 70px;
        padding-right: 70px;
        alignment: center;
        spacing: 14px;

        Text {
            text: "어디에 설치할까요?";
            color: #111827;
            font-size: 22px;
            font-weight: 800;
        }
        Text {
            text: "기본 위치가 선택되어 있어요. 바꾸고 싶다면 경로를 수정해 주세요.";
            color: #6b7280;
            font-size: 12px;
        }
        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                text <=> root.install-path;
            }
            SecondaryButton {
                text: "찾아보기";
                clicked => { root.browse-clicked(); }
            }
        }
        CheckBox {
            text: "바탕화면 바로가기 만들기";
            checked <=> root.create-desktop-shortcut;
        }
        CheckBox {
            text: "종료 시 런처 시작";
            checked <=> root.run-after-install;
        }
        PrimaryButton {
            text: "설치";
            clicked => { root.continue-clicked(); }
        }
    }
}

component InstallingPage inherits Rectangle {
    in property <int> percent;
    in property <string> message;

    background: transparent;

    VerticalLayout {
        padding-left: 70px;
        padding-right: 70px;
        alignment: center;
        spacing: 14px;

        Text {
            text: "설치하는 중이에요";
            color: #111827;
            font-size: 22px;
            font-weight: 800;
        }
        Text {
            text: "곧 끝나요. 잠시만 기다려 주세요.";
            color: #6b7280;
            font-size: 12px;
        }
        Text {
            text: percent + "%";
            color: #111827;
            font-size: 38px;
            font-weight: 900;
        }
        Rectangle {
            height: 6px;
            background: #dfe3e8;
            border-radius: 3px;
            Rectangle {
                width: parent.width * percent / 100;
                height: 6px;
                background: #0b73f6;
                border-radius: 3px;
            }
        }
        Text {
            text: message;
            color: #6b7280;
            font-size: 12px;
        }
    }
}

component CompletePage inherits Rectangle {
    in-out property <bool> run-after-install;
    callback close-clicked();

    background: transparent;

    VerticalLayout {
        padding-left: 90px;
        padding-right: 90px;
        alignment: center;
        spacing: 14px;

        Rectangle {
            width: 54px;
            height: 54px;
            border-radius: 27px;
            background: #0b73f6;
            Text {
                text: "✓";
                color: #ffffff;
                font-size: 24px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: "다 됐어요!";
            color: #111827;
            font-size: 25px;
            font-weight: 800;
        }
        Text {
            text: "Rendog Launcher 설치가 완료됐어요.";
            color: #6b7280;
            font-size: 12px;
        }
        CheckBox {
            text: "종료 시 런처 시작";
            checked <=> root.run-after-install;
        }
        HorizontalLayout {
            spacing: 8px;

            PrimaryButton {
                text: "지금 실행";
                clicked => { root.close-clicked(); }
            }

            TextButton {
                text: "닫기";
                clicked => { root.run-after-install = false; root.close-clicked(); }
            }
        }
    }
}

component ErrorPage inherits Rectangle {
    in property <string> error-code;
    in property <string> error-message;
    callback retry-clicked();
    callback close-clicked();

    background: transparent;

    VerticalLayout {
        padding-left: 90px;
        padding-right: 90px;
        alignment: center;
        spacing: 14px;

        Rectangle {
            width: 54px;
            height: 54px;
            border-radius: 27px;
            background: #ef4444;

            Text {
                text: "!";
                color: #ffffff;
                font-size: 28px;
                font-weight: 900;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: "이런, 문제가 생겼어요";
            color: #111827;
            font-size: 25px;
            font-weight: 800;
        }

        Text {
            text: error-code;
            color: #ef4444;
            font-size: 12px;
            font-weight: 700;
        }

        Text {
            text: error-message;
            color: #6b7280;
            font-size: 12px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;

            PrimaryButton {
                text: "다시 시도";
                clicked => { root.retry-clicked(); }
            }

            TextButton {
                text: "닫기";
                clicked => { root.close-clicked(); }
            }
        }
    }
}

export component InstallerWindow inherits Window {
    in-out property <string> product-name: "Rendog Launcher";
    in-out property <string> installer-name: "Rendog Launcher Installer";
    in-out property <string> install-path: "";
    in-out property <int> current-step: 0;
    in-out property <bool> run-after-install: true;
    in-out property <bool> create-desktop-shortcut: true;
    in-out property <int> progress-percent: 0;
    in-out property <string> progress-message: "설치 준비 중...";
    in-out property <string> error-code: "";
    in-out property <string> error-message: "";

    callback continue-clicked();
    callback close-clicked();
    callback browse-clicked();
    callback title-drag-started(float, float);
    callback title-drag-moved(float, float);
    callback minimize-clicked();

    title: installer-name;
    no-frame: true;
    width: 900px;
    height: 560px;
    background: #f8f9fb;

    VerticalLayout {
        spacing: 0px;

        TitleBar {
            title: root.installer-name;
            drag-started(x, y) => { root.title-drag-started(x, y); }
            drag-moved(x, y) => { root.title-drag-moved(x, y); }
            minimize-clicked => { root.minimize-clicked(); }
            close-clicked => { root.close-clicked(); }
        }

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 220px;
                background: #eef7f6;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: #dbe7e5;
                }

                VerticalLayout {
                    padding: 28px;
                    spacing: 28px;

                    HorizontalLayout {
                        spacing: 10px;
                        Image {
                            width: 32px;
                            height: 32px;
                            source: @image-url("../assets/rendog-logo-32.png");
                        }
                        VerticalLayout {
                            spacing: 0px;
                            Text {
                                text: "RENDOG";
                                font-size: 13px;
                                font-weight: 800;
                                color: #111827;
                            }
                            Text {
                                text: "LAUNCHER";
                                font-size: 9px;
                                color: #6b7280;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 16px;
                        StepRow { label: "시작"; number: 1; active: current-step >= 0; done: current-step > 0; }
                        StepRow { label: "설치 경로"; number: 2; active: current-step >= 1; done: current-step > 1; }
                        StepRow { label: "설치"; number: 3; active: current-step >= 2; done: current-step > 2; }
                        StepRow { label: "완료"; number: 4; active: current-step >= 3; done: false; }
                    }

                    VerticalLayout {
                        alignment: end;
                        Text {
                            text: "v1.0.0";
                            font-size: 10px;
                            color: #9ca3af;
                        }
                    }
                }
            }

            Rectangle {
                background: #fbfbfc;

                if current-step == 0: WelcomePage {
                    product-name: root.product-name;
                    continue-clicked => { root.continue-clicked(); }
                }

                if current-step == 1: PathPage {
                    install-path <=> root.install-path;
                    run-after-install <=> root.run-after-install;
                    create-desktop-shortcut <=> root.create-desktop-shortcut;
                    continue-clicked => { root.continue-clicked(); }
                    browse-clicked => { root.browse-clicked(); }
                }

                if current-step == 2: InstallingPage {
                    percent: root.progress-percent;
                    message: root.progress-message;
                }

                if current-step == 3: CompletePage {
                    run-after-install <=> root.run-after-install;
                    close-clicked => { root.close-clicked(); }
                }

                if current-step == 4: ErrorPage {
                    error-code: root.error-code;
                    error-message: root.error-message;
                    retry-clicked => { root.continue-clicked(); }
                    close-clicked => { root.close-clicked(); }
                }
            }
        }

    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;
        border-width: 1px;
        border-color: #d8dee8;
    }
}
