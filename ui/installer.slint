import { Theme } from "theme.slint";
import { CheckGlyph, StepItem, PrimaryButton, SecondaryButton, TextButton, PathInput, OptionCheckBox } from "controls.slint";
import { TitleBar } from "title_bar.slint";

component Sidebar inherits Rectangle {
    in property <int> current-step;
    in property <string> version;

    background: Theme.sidebar;

    VerticalLayout {
        padding-top: 32px;
        padding-bottom: 26px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 0px;

        HorizontalLayout {
            spacing: 11px;
            alignment: start;
            vertical-stretch: 0;

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: #dbdee2;
                    background: #ffffff;
                    clip: true;

                    Image {
                        width: 30px;
                        height: 30px;
                        image-fit: contain;
                        source: @image-url("../assets/erkuia-logo-96.png");
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: "ERKUIA";
                    font-size: 13.5px;
                    font-weight: 700;
                    color: Theme.heading;
                }

                Text {
                    text: "LAUNCHER";
                    font-size: 9px;
                    font-weight: 700;
                    letter-spacing: 1.1px;
                    color: Theme.muted;
                }
            }
        }

        Rectangle {
            height: 40px;
            background: transparent;
        }

        VerticalLayout {
            spacing: 0px;
            vertical-stretch: 0;

            StepItem {
                label: "시작";
                number: 1;
                active: root.current-step == 0;
                done: root.current-step > 0;
            }

            StepItem {
                label: "설치 경로";
                number: 2;
                active: root.current-step == 1;
                done: root.current-step > 1;
            }

            StepItem {
                label: "설치";
                number: 3;
                active: root.current-step == 2 || root.current-step == 4;
                done: root.current-step == 3;
            }

            StepItem {
                label: "완료";
                number: 4;
                active: root.current-step == 3;
                done: false;
                last: true;
            }
        }

        Rectangle {
            background: transparent;
            vertical-stretch: 1;
        }

        Text {
            text: root.version;
            font-size: 10.5px;
            color: #95999c;
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.line;
    }
}

component WelcomePage inherits Rectangle {
    in property <string> product-name;
    callback start-clicked();

    background: transparent;

    VerticalLayout {
        padding-left: 50px;
        padding-right: 50px;
        alignment: center;
        spacing: 0px;

        HorizontalLayout {
            alignment: start;

            Image {
                width: 96px;
                height: 96px;
                image-fit: contain;
                source: @image-url("../assets/erkuia-logo-256.png");
            }
        }

        Rectangle {
            height: 18px;
            background: transparent;
        }

        Text {
            text: "반가워요! " + root.product-name + "를\n설치해 볼게요";
            color: Theme.heading;
            font-size: 25px;
            font-weight: 700;
        }

        Rectangle {
            height: 14px;
            background: transparent;
        }

        Text {
            text: "해당 서버 전용으로 만들어진 런처예요.\n몇 단계만 거치면 바로 즐길 수 있어요.";
            color: Theme.body;
            font-size: 12.5px;
        }

        Rectangle {
            height: 28px;
            background: transparent;
        }

        HorizontalLayout {
            alignment: start;

            PrimaryButton {
                text: "시작";
                clicked => {
                    root.start-clicked();
                }
            }
        }
    }
}

component PathPage inherits Rectangle {
    in-out property <string> install-path;
    in property <string> capacity-text;
    callback install-clicked();
    callback back-clicked();
    callback browse-clicked();

    background: transparent;

    VerticalLayout {
        padding-top: 44px;
        padding-bottom: 44px;
        padding-left: 50px;
        padding-right: 50px;
        spacing: 0px;

        Text {
            text: "어디에 설치할까요?";
            color: Theme.heading;
            font-size: 20px;
            font-weight: 700;
        }

        Rectangle {
            height: 9px;
            background: transparent;
        }

        Text {
            text: "기본 위치가 대부분 잘 맞아요. 바꾸고 싶다면 원하는 폴더를 골라주세요.";
            color: Theme.body;
            font-size: 12.5px;
        }

        Rectangle {
            height: 25px;
            background: transparent;
        }

        HorizontalLayout {
            spacing: 9px;

            PathInput {
                text <=> root.install-path;
                horizontal-stretch: 1;
            }

            SecondaryButton {
                text: "찾아보기";
                horizontal-stretch: 0;
                clicked => {
                    root.browse-clicked();
                }
            }
        }

        Rectangle {
            height: 13px;
            background: transparent;
        }

        Text {
            text: root.capacity-text;
            color: Theme.muted;
            font-size: 11.5px;
        }

        Rectangle {
            background: transparent;
            vertical-stretch: 1;
        }

        Rectangle {
            height: 1px;
            background: #e8eaee;
        }

        Rectangle {
            height: 18px;
            background: transparent;
        }

        HorizontalLayout {
            alignment: end;
            spacing: 14px;

            TextButton {
                text: "이전";
                clicked => {
                    root.back-clicked();
                }
            }

            PrimaryButton {
                text: "설치";
                clicked => {
                    root.install-clicked();
                }
            }
        }
    }
}

component InstallingPage inherits Rectangle {
    in property <int> percent;
    in property <string> message;

    background: transparent;

    VerticalLayout {
        padding-left: 50px;
        padding-right: 50px;
        alignment: center;
        spacing: 0px;

        Text {
            text: "설치하는 중이에요";
            color: Theme.heading;
            font-size: 20px;
            font-weight: 700;
        }

        Rectangle {
            height: 4px;
            background: transparent;
        }

        Text {
            text: "곧 끝나요! 잠시만 기다려 주세요.";
            color: Theme.body;
            font-size: 12.5px;
        }

        Rectangle {
            height: 34px;
            background: transparent;
        }

        Text {
            text: root.percent + "%";
            color: Theme.heading;
            font-size: 40px;
            font-weight: 800;
        }

        Rectangle {
            height: 16px;
            background: transparent;
        }

        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.line;
            clip: true;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * Math.clamp(root.percent, 0, 100) / 100;
                height: parent.height;
                border-radius: 4px;
                background: Theme.accent;
            }
        }

        Rectangle {
            height: 11px;
            background: transparent;
        }

        Text {
            text: root.message;
            color: #787b7e;
            font-size: 11.5px;
            overflow: elide;
        }
    }
}

component CompletePage inherits Rectangle {
    in-out property <bool> create-desktop-shortcut;
    in-out property <bool> run-after-install;
    in property <string> product-name;
    callback close-clicked();

    background: transparent;

    VerticalLayout {
        padding-left: 50px;
        padding-right: 50px;
        alignment: center;
        spacing: 0px;

        HorizontalLayout {
            alignment: start;

            Rectangle {
                width: 50px;
                height: 50px;
                border-radius: 25px;
                background: Theme.accent;

                CheckGlyph {
                    width: 26px;
                    height: 26px;
                    thickness: 2.2px;
                }
            }
        }

        Rectangle {
            height: 20px;
            background: transparent;
        }

        Text {
            text: "다 됐어요!";
            color: Theme.heading;
            font-size: 22px;
            font-weight: 700;
        }

        Rectangle {
            height: 7px;
            background: transparent;
        }

        Text {
            text: "이제 " + root.product-name + "를 즐길 준비가 됐어요.";
            color: Theme.body;
            font-size: 12.5px;
        }

        Rectangle {
            height: 22px;
            background: transparent;
        }

        HorizontalLayout {
            alignment: start;

            OptionCheckBox {
                text: "바탕화면 바로가기 만들기";
                checked <=> root.create-desktop-shortcut;
            }
        }

        Rectangle {
            height: 10px;
            background: transparent;
        }

        HorizontalLayout {
            alignment: start;

            OptionCheckBox {
                text: "설치 마법사 종료 후 런처 실행";
                checked <=> root.run-after-install;
            }
        }

        Rectangle {
            height: 26px;
            background: transparent;
        }

        HorizontalLayout {
            alignment: start;

            PrimaryButton {
                text: "종료";
                clicked => {
                    root.close-clicked();
                }
            }
        }
    }
}

component ErrorPage inherits Rectangle {
    in property <string> error-code;
    in property <string> error-message;
    callback retry-clicked();
    callback close-clicked();

    background: transparent;

    VerticalLayout {
        padding-left: 50px;
        padding-right: 50px;
        alignment: center;
        spacing: 0px;

        HorizontalLayout {
            alignment: start;

            Rectangle {
                width: 50px;
                height: 50px;
                border-radius: 25px;
                background: Theme.danger;

                Text {
                    text: "!";
                    color: #ffffff;
                    font-size: 24px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 20px;
            background: transparent;
        }

        Text {
            text: "이런, 문제가 생겼어요";
            color: Theme.heading;
            font-size: 22px;
            font-weight: 700;
        }

        Rectangle {
            height: 7px;
            background: transparent;
        }

        Text {
            text: root.error-message;
            color: Theme.body;
            font-size: 12.5px;
            wrap: word-wrap;
        }

        Rectangle {
            height: 12px;
            background: transparent;
        }

        Text {
            text: "오류 코드: " + root.error-code;
            color: #8c8f93;
            font-size: 11px;
        }

        Rectangle {
            height: 26px;
            background: transparent;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 6px;

            PrimaryButton {
                text: "다시 시도";
                clicked => {
                    root.retry-clicked();
                }
            }

            TextButton {
                text: "닫기";
                clicked => {
                    root.close-clicked();
                }
            }
        }
    }
}

export component InstallerWindow inherits Window {
    in-out property <string> product-name: "Erkuia Launcher";
    in-out property <string> installer-name: "Erkuia Launcher Installer";
    in-out property <string> installer-version: "v0.1.1";
    in-out property <string> install-path: "";
    in-out property <string> capacity-text: "";
    in-out property <int> current-step: 0;
    in-out property <bool> run-after-install: true;
    in-out property <bool> create-desktop-shortcut: true;
    in-out property <int> progress-percent: 0;
    in-out property <string> progress-message: "설치 준비 중...";
    in-out property <string> error-code: "";
    in-out property <string> error-message: "";

    callback start-clicked();
    callback install-clicked();
    callback back-clicked();
    callback retry-clicked();
    callback close-clicked();
    callback browse-clicked();
    callback title-drag-started(float, float);
    callback title-drag-moved(float, float);
    callback title-drag-ended();
    callback minimize-clicked();

    title: root.installer-name;
    no-frame: true;
    width: 900px;
    height: 576px;
    background: transparent;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.surface;
        border-radius: 8px;
        clip: true;

        VerticalLayout {
            spacing: 0px;

            TitleBar {
                title: root.installer-name;
                drag-started(x, y) => {
                    root.title-drag-started(x, y);
                }
                drag-moved(x, y) => {
                    root.title-drag-moved(x, y);
                }
                drag-ended => {
                    root.title-drag-ended();
                }
                minimize-clicked => {
                    root.minimize-clicked();
                }
                close-clicked => {
                    root.close-clicked();
                }
            }

            HorizontalLayout {
                spacing: 0px;

                Sidebar {
                    width: 234px;
                    current-step: root.current-step;
                    version: root.installer-version;
                }

                Rectangle {
                    background: Theme.surface;

                    if root.current-step == 0: WelcomePage {
                        product-name: root.product-name;
                        start-clicked => {
                            root.start-clicked();
                        }
                    }

                    if root.current-step == 1: PathPage {
                        install-path <=> root.install-path;
                        capacity-text: root.capacity-text;
                        install-clicked => {
                            root.install-clicked();
                        }
                        back-clicked => {
                            root.back-clicked();
                        }
                        browse-clicked => {
                            root.browse-clicked();
                        }
                    }

                    if root.current-step == 2: InstallingPage {
                        percent: root.progress-percent;
                        message: root.progress-message;
                    }

                    if root.current-step == 3: CompletePage {
                        product-name: root.product-name;
                        create-desktop-shortcut <=> root.create-desktop-shortcut;
                        run-after-install <=> root.run-after-install;
                        close-clicked => {
                            root.close-clicked();
                        }
                    }

                    if root.current-step == 4: ErrorPage {
                        error-code: root.error-code;
                        error-message: root.error-message;
                        retry-clicked => {
                            root.retry-clicked();
                        }
                        close-clicked => {
                            root.close-clicked();
                        }
                    }
                }
            }
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: transparent;
            border-width: 1px;
            border-color: Theme.frame-border;
            border-radius: 8px;
        }
    }
}
