export global Theme {
    // A warm near-black ground. Panels sit a step lighter rather than a step
    // darker, which is the whole reason the text ramp below is inverted from
    // what a light theme would use.
    out property <color> surface: #211e1d;
    out property <color> raised: #2b2827;
    out property <color> frame-border: #423e3c;
    out property <color> line: #3a3634;

    // On a dark ground the accent has to be the light thing, so the primary
    // button is near-white with dark text on it. Keeps the monochrome logo and
    // the one pressable thing speaking the same language.
    out property <color> accent: #e9e6e4;
    out property <color> accent-hover: #f5f3f1;
    out property <color> accent-pressed: #d0cdcb;
    out property <color> on-accent: #211e1d;
    // Lifted well off the background: the light-theme red went muddy here.
    out property <color> danger: #e2645e;
    out property <color> danger-pressed: #c9524c;

    // Inverted ramp, brightest first.
    out property <color> heading: #f5f3f2;
    out property <color> title: #e9e6e4;
    out property <color> menu-text: #ddd9d7;
    out property <color> strong: #cec9c7;
    out property <color> body: #bdb8b6;
    out property <color> label: #aeaaa7;
    out property <color> secondary: #a29d9a;
    out property <color> muted: #96918e;
    out property <color> tick: #8b8683;
    out property <color> disabled-text: #7f7a77;
    out property <color> faint: #726d6a;

    out property <color> control: #4a4543;
    out property <color> control-off: #3d3937;
    out property <color> badge: #35312f;
    out property <color> dashed-border: #4d4846;

    // Inputs go darker than the panel they sit in — the one place where "below"
    // still reads as inset on a dark theme.
    out property <color> field-background: #1a1817;
    out property <color> field-border: #45403e;
    out property <color> field-text: #ddd9d7;
    out property <color> button-border: #45403e;

    // Flipped with everything else, or the tooltip would vanish into the panel.
    out property <color> tooltip: #e9e6e4;
    out property <color> tooltip-text: #211e1d;
    // Heavier than the light theme's: dimming a dark ground takes more.
    out property <color> scrim: #00000099;

    out property <length> radius-window: 16px;
    out property <length> radius-modal: 14px;
    out property <length> radius-popover: 12px;
    out property <length> radius-primary: 12px;
    out property <length> radius-button: 10px;
    out property <length> radius-control: 8px;
    out property <length> radius-icon-button: 8px;
    out property <length> radius-modal-close: 7px;
    out property <length> radius-tooltip: 6px;
    out property <length> radius-avatar: 8px;
    out property <length> radius-chip: 12px;
    out property <length> radius-badge: 11px;
    out property <length> radius-toggle: 12px;
    out property <length> radius-toggle-knob: 9px;
    out property <length> radius-track: 3px;
    out property <length> radius-thumb: 8px;

    out property <length> window-width: 1000px;
    out property <length> window-height: 640px;
    out property <length> title-bar-height: 44px;
    out property <length> title-bar-pad-left: 18px;
    out property <length> title-bar-pad-right: 14px;
    out property <length> content-pad-x: 40px;
    out property <length> content-pad-top: 28px;
    out property <length> content-pad-bottom: 40px;

    out property <length> modal-width: 460px;
    out property <length> modal-height: 560px;

    /// Past this the mod list scrolls instead of growing the modal.
    out property <length> settings-list-max-height: 380px;
    out property <length> modal-pad-x: 26px;
    out property <length> modal-pad-top: 24px;
    out property <length> modal-pad-bottom: 26px;

    out property <length> popover-width: 240px;
    out property <length> popover-pad: 9px;
    out property <length> popover-offset-y: 46px;

    out property <length> logo-size: 132px;
    out property <length> logo-glyph: 102px;
    out property <length> icon-button-size: 28px;
    out property <length> avatar-size: 30px;
    out property <length> settings-button-height: 36px;
    out property <length> toggle-width: 40px;
    out property <length> toggle-height: 24px;
    out property <length> toggle-knob: 18px;
    out property <length> dash-length: 5px;
    out property <length> dash-gap: 4px;

    out property <length> progress-width: 220px;
    out property <length> progress-track: 8px;
    out property <length> radius-progress: 4px;

    out property <length> slider-track: 6px;
    out property <length> slider-thumb: 16px;
    out property <length> slider-thumb-border: 2px;
    out property <length> slider-height: 52px;
    out property <length> slider-track-top: 24px;
    out property <length> slider-tick-top: 38px;
    out property <length> slider-tick-height: 14px;
    out property <length> slider-tooltip-height: 19px;

    out property <length> shadow-window-blur: 50px;
    out property <length> shadow-window-offset-y: 20px;
    out property <color> shadow-window-color: #13161a4d;

    out property <length> shadow-modal-blur: 50px;
    out property <length> shadow-modal-offset-y: 20px;
    out property <color> shadow-modal-color: #02030666;

    out property <length> shadow-popover-blur: 40px;
    out property <length> shadow-popover-offset-y: 16px;
    out property <color> shadow-popover-color: #0203064d;

    out property <length> shadow-knob-blur: 3px;
    out property <length> shadow-knob-offset-y: 1px;
    out property <color> shadow-knob-color: #13161a4d;
}

export global Typo {
    out property <string> family: "Inter";

    out property <length> title-bar: 12.5px;
    out property <length> hero-title: 15px;
    out property <length> hero-subtitle: 12.5px;
    out property <length> primary-button: 15px;
    out property <length> modal-title: 16px;
    out property <length> section-caps: 11.5px;
    out property <length> body: 13px;
    out property <length> account-name: 13.5px;
    out property <length> avatar-initial: 14px;
    out property <length> small: 12px;
    out property <length> caption: 11.5px;
    out property <length> footer: 11px;
    out property <length> tick: 10.5px;
    out property <length> badge: 10.5px;
    out property <length> chevron: 10px;
    out property <length> icon-glyph: 15px;
    out property <length> modal-close: 14px;

    out property <length> hero-title-spacing: 2.4px;
    out property <length> hero-subtitle-spacing: 0.25px;
    out property <length> section-caps-spacing: 0.69px;

    out property <int> regular: 400;
    out property <int> medium: 500;
    out property <int> semibold: 600;
    out property <int> bold: 700;
}
